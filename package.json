{
  "name": "@feedhive/setup-openclaw",
  "version": "0.1.3",
  "description": "FeedHive OpenClaw setup CLI",
  "main": "dist/cli.js",
  "bin": "dist/cli.js",
  "files": [
    "dist",
    "artifacts",
    "README.md"
  ],
  "scripts": {
    "start": "webpack --config ./config/webpack/config.development.ts --watch",
    "build": "webpack --config ./config/webpack/config.npm.ts",
    "build:dev": "webpack --config ./config/webpack/config.development.ts",
    "prepare-package": "ts-node ./config/scripts/prepare-package.ts",
    "patch-version": "ts-node ./config/scripts/version-bump.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --project tsconfig.npm.json --noEmit --composite false",
    "lint:code": "eslint . --ext .js,.jsx,.ts,.tsx",
    "prebuild": "rimraf dist"
  },
  "keywords": [
    "feedhive",
    "openclaw",
    "cli",
    "api",
    "automation",
    "agent"
  ],
  "author": "Simon Hoiberg",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://www.feedhive.com",
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-env": "^7.26.9",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/runtime": "^7.26.10",
    "@types/node": "^20.17.24",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "4.24.0",
    "@typescript-eslint/parser": "4.24.0",
    "babel-loader": "^8.4.1",
    "eslint": "7.27.0",
    "eslint-config-airbnb": "18.2.1",
    "eslint-plugin-import": "2.23.3",
    "eslint-plugin-jsx-a11y": "6.4.1",
    "eslint-plugin-react": "7.23.2",
    "eslint-plugin-react-hooks": "4.2.0",
    "eslint-plugin-unused-imports": "1.1.1",
    "prettier": "^3.5.3",
    "rimraf": "^5.0.10",
    "terser-webpack-plugin": "^5.3.14",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "typescript": "5.1.6",
    "vitest": "^4.1.4",
    "webpack": "^5.98.0",
    "webpack-cli": "^6.0.1"
  }
}
